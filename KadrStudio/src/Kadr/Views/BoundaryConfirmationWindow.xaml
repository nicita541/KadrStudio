<Window x:Class="KadrStudio.Views.BoundaryConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение границ OP / ED" Width="980" Height="690"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="BoundaryHeadingText" Text="Покадровая проверка границ" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                       Text="Независимые признаки совпали не полностью. Draft не будет создан, пока вы не подтвердите начало и конец Opening/Ending. Post-credit и preview не удаляются."/>
        </StackPanel>
        <ListBox x:Name="CandidateList" Grid.Row="1" ItemsSource="{Binding Rows}" SelectionChanged="CandidateList_SelectionChanged"
                 DisplayMemberPath="Label" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"/>
        <Grid Grid.Row="2" Margin="0,12,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="Black"><Grid><Image x:Name="BeforeImage" Stretch="Uniform"/><TextBlock Text="КАДР ДО" Foreground="White" Margin="8" FontWeight="SemiBold"/></Grid></Border>
            <Border Grid.Column="2" Background="Black"><Grid><Image x:Name="AfterImage" Stretch="Uniform"/><TextBlock Text="КАДР ПОСЛЕ" Foreground="White" Margin="8" FontWeight="SemiBold"/></Grid></Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ExactTimeText" VerticalAlignment="Center" FontFamily="Consolas"/>
            <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="← 1 кадр" Click="PreviousFrame_Click" Padding="12,7"/>
            <Button Grid.Column="3" Style="{StaticResource ButtonBase}" Content="1 кадр →" Click="NextFrame_Click" Padding="12,7"/>
            <TextBlock x:Name="EvidenceText" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Подтверждение сохраняется как точный PTS и номер кадра." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="Отмена — Draft не создавать" Click="Cancel_Click" Padding="12,7"/>
            <Button x:Name="ConfirmBoundariesButton" Grid.Column="3" Style="{StaticResource AccentButton}" Content="Подтвердить границы" Click="Confirm_Click" Padding="12,7"/>
        </Grid>
    </Grid>
</Window>
