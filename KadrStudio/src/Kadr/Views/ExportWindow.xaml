<Window x:Class="KadrStudio.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт — Kadr Studio"
        Width="510"
        Height="590"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        Closing="Window_Closing">
    <Grid Margin="26" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,23">
            <TextBlock Text="Экспорт видео" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Готовый файл будет сохранён в формате MP4 (H.264)."
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,9,0">
                <TextBlock Text="Разрешение" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6" />
                <ComboBox x:Name="ResolutionCombo" SelectedIndex="2">
                    <ComboBoxItem Content="480p" Tag="P480" />
                    <ComboBoxItem Content="720p HD" Tag="P720" />
                    <ComboBoxItem Content="1080p Full HD" Tag="P1080" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                <TextBlock Text="Качество" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6" />
                <ComboBox x:Name="QualityCombo" SelectedIndex="1">
                    <ComboBoxItem Content="Высокое" Tag="18" />
                    <ComboBoxItem Content="Оптимальное" Tag="20" />
                    <ComboBoxItem Content="Компактное" Tag="23" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelRaisedBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,18">
            <CheckBox x:Name="HardwareEncodingCheck"
                      Content="Использовать NVIDIA NVENC, если доступен"
                      Foreground="{StaticResource TextBrush}"
                      IsChecked="True" />
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,18">
            <TextBlock Text="Куда сохранить" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OutputPathText" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Click="Browse_Click" Content="Обзор…" Margin="9,0,0,0" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="4" Background="#121318" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StageText" Grid.Row="0" Text="Готово к экспорту" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText" Grid.Row="1" Text="Выберите параметры и нажмите «Экспортировать»." Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,11" />
                <Grid Grid.Row="2">
                    <ProgressBar x:Name="ExportProgressBar" Minimum="0" Maximum="100" Height="7" Value="0" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="10" HorizontalAlignment="Right" Margin="0,12,0,0" />
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5"
                   Text="Экспорт выполняется полностью локально. Исходные файлы проекта не изменяются."
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top" />

        <Grid Grid.Row="6" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenFolderButton" Grid.Column="0" Style="{StaticResource ButtonBase}" Click="OpenFolder_Click" Content="Показать файл" Visibility="Collapsed" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="CancelButton" Style="{StaticResource ButtonBase}" Click="Cancel_Click" Content="Закрыть" Margin="0,0,10,0" />
                <Button x:Name="StartExportButton" Style="{StaticResource AccentButton}" Click="StartExport_Click" Content="Экспортировать" Padding="20,9" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
