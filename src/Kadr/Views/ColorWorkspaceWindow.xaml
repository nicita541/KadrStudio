<Window x:Class="KadrStudio.Views.ColorWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Цвет — Kadr Studio"
        Width="420" Height="570" MinWidth="360" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        Closed="Window_Closed">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="WorkspaceRoot" Margin="20">
            <TextBlock Text="Цветокоррекция" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="SelectedClipNameTextBlock" Text="Выберите видеоклип" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,5,0,20" />

            <TextBlock Text="Яркость" />
            <Slider Minimum="-1" Maximum="1" Value="{Binding Brightness}" PreviewMouseLeftButtonDown="Edit_Begin" PreviewMouseLeftButtonUp="Edit_End" Margin="0,5,0,16" />
            <TextBlock Text="Контраст" />
            <Slider Minimum="0" Maximum="3" Value="{Binding Contrast}" PreviewMouseLeftButtonDown="Edit_Begin" PreviewMouseLeftButtonUp="Edit_End" Margin="0,5,0,16" />
            <TextBlock Text="Насыщенность" />
            <Slider Minimum="0" Maximum="3" Value="{Binding Saturation}" PreviewMouseLeftButtonDown="Edit_Begin" PreviewMouseLeftButtonUp="Edit_End" Margin="0,5,0,16" />
            <Grid Margin="0,0,0,5"><TextBlock Text="Температура"/><TextBlock Text="холоднее" HorizontalAlignment="Center" Foreground="#93C5FD" FontSize="10"/><TextBlock Text="теплее" HorizontalAlignment="Right" Foreground="#FBBF24" FontSize="10"/></Grid>
            <Slider Minimum="-1" Maximum="1" Value="{Binding Temperature}" PreviewMouseLeftButtonDown="Edit_Begin" PreviewMouseLeftButtonUp="Edit_End" Margin="0,5,0,22" />

            <Button Style="{StaticResource ButtonBase}" Click="Reset_Click" Content="Сбросить цветокоррекцию" Padding="12,8" />
            <TextBlock Text="Коррекция применяется к выбранному видеоклипу при экспорте."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
