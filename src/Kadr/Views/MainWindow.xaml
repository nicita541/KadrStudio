<Window x:Class="KadrStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:KadrStudio.Controls"
        mc:Ignorable="d"
        Title="Kadr Studio"
        Width="1500"
        Height="920"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="3*" MinHeight="220" />
            <RowDefinition Height="6" />
            <RowDefinition Height="2*" MinHeight="220" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="300" MinWidth="210" MaxWidth="440" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Компактная IDE-панель -->
        <Border Grid.Row="0" Grid.ColumnSpan="6" Background="#17181D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border Width="25" Height="25" CornerRadius="6" Background="{StaticResource AccentBrush}" Margin="0,0,7,0">
                        <TextBlock Text="К" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Kadr Studio" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopMenuButton}" Content="Файл" Click="TopMenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Новый проект" InputGestureText="Ctrl+N" Click="NewProject_Click" />
                                <MenuItem Header="Открыть…" InputGestureText="Ctrl+O" Click="OpenProject_Click" />
                                <MenuItem Header="Сохранить" InputGestureText="Ctrl+S" Click="SaveProject_Click" />
                                <MenuItem Header="История проекта…" InputGestureText="Ctrl+H" Click="ProjectHistory_Click" />
                                <Separator Margin="4,2" />
                                <MenuItem Header="Выход" Click="Exit_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource TopMenuButton}" Content="Правка" Click="TopMenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Отменить" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                                <MenuItem Header="Повторить" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                                <Separator Margin="4,2" />
                                <MenuItem Header="Разрезать" InputGestureText="S" Click="Split_Click" />
                                <MenuItem Header="Удалить клип" InputGestureText="Delete" Click="DeleteClip_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource TopMenuButton}" Content="Вид" Click="TopMenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Медиатека" Click="ShowMedia_Click" />
                                <MenuItem Header="Анализ" Click="ShowAnalysis_Click" />
                                <MenuItem Header="История версий" Click="ShowHistory_Click" />
                                <Separator Margin="4,2" />
                                <MenuItem Header="Обработка звука…" Click="OpenAudioWorkspace_Click" />
                                <MenuItem Header="Цветокоррекция…" Click="OpenColorWorkspace_Click" />
                                <Separator Margin="4,2" />
                                <MenuItem Header="Показать весь таймлайн" Click="ZoomToFit_Click" />
                                <MenuItem Header="Увеличить" Click="ZoomIn_Click" />
                                <MenuItem Header="Уменьшить" Click="ZoomOut_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource TopMenuButton}" Content="Справка" Click="TopMenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="О Kadr Studio" Click="About_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <Border Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="#22232A"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="6,6,0,0"
                        Height="34"
                        MinWidth="170"
                        Padding="9,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                        <TextBox Text="{Binding Project.Name, UpdateSourceTrigger=LostFocus}"
                                 Width="160"
                                 MaxLength="80"
                                 Padding="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 ToolTip="Название проекта" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CompactIconButton}" ToolTip="Новый проект" Click="NewProject_Click" Content="&#xE710;" Margin="0,0,3,0" />
                    <Button Style="{StaticResource CompactIconButton}" ToolTip="Сохранить (Ctrl+S)" Click="SaveProject_Click" Content="&#xE74E;" Margin="0,0,8,0" />
                    <Button Style="{StaticResource CompactIconButton}" ToolTip="История проекта (Ctrl+H)" Click="ProjectHistory_Click" Content="&#xE81C;" Margin="0,0,8,0" />
                    <Button Style="{StaticResource CompactIconButton}" ToolTip="Отменить" Click="Undo_Click" Content="&#xE7A7;" IsEnabled="{Binding CanUndo}" Margin="0,0,3,0" />
                    <Button Style="{StaticResource CompactIconButton}" ToolTip="Повторить" Click="Redo_Click" Content="&#xE7A6;" IsEnabled="{Binding CanRedo}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentButton}"
                            IsEnabled="{Binding CanExport}"
                            Click="Export_Click"
                            Padding="14,6"
                            Height="30"
                            Content="Экспорт" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Навигация -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,8">
                <Button x:Name="MediaNavButton" Style="{StaticResource NavButton}" Tag="Selected" ToolTip="Ваши медиа" Click="ShowMedia_Click">
                    <StackPanel>
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M3,5 L8,5 L10,7 L21,7 L21,19 L3,19 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round"/><Path Data="M7,16 L11,12 L14,15 L17,11 L21,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"/></Canvas></Viewbox>
                        <TextBlock Text="Медиа" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="AnalysisNavButton" Style="{StaticResource NavButton}" ToolTip="Локальный анализ видео" Click="ShowAnalysis_Click">
                    <StackPanel>
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M3,18 L7,14 L10,16 L14,8 L18,12 L21,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M3,21 L21,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Canvas></Viewbox>
                        <TextBlock Text="Анализ" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="HistoryNavButton" Style="{StaticResource NavButton}" ToolTip="История версий проекта" Click="ShowHistory_Click">
                    <StackPanel>
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M5,7 A8,8 0 1 1 4,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Fill="Transparent"/><Path Data="M5,3 L5,8 L10,8 M12,7 L12,12 L16,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                        <TextBlock Text="История" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="TextNavButton" Style="{StaticResource NavButton}" ToolTip="Текст и автосубтитры" Click="ShowText_Click">
                    <StackPanel>
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M4,5 L20,5 M12,5 L12,20 M8,20 L16,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                        <TextBlock Text="Текст" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="TransitionsNavButton" Style="{StaticResource NavButton}" ToolTip="Переходы между соседними клипами" Click="ShowTransitions_Click">
                    <StackPanel>
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M3,5 L13,5 L13,19 L3,19 Z M11,12 L21,5 L21,19 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round"/></Canvas></Viewbox>
                        <TextBlock Text="Переходы" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Медиатека -->
        <Border x:Name="MediaPanel" Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Ваши медиа" FontSize="18" FontWeight="SemiBold" Margin="2,2,0,13" />
                <Button Grid.Row="1" Style="{StaticResource AccentButton}" Click="ImportMedia_Click" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" />
                        <TextBlock Text="Импортировать медиа" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <TextBox Grid.Row="2"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,9"
                         ToolTip="Поиск в медиатеке" />

                <Grid Grid.Row="3">
                    <TextBlock Text="Импортируйте видео, аудио или изображения. Затем дважды нажмите на файл или перетащите его на таймлайн."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="245"
                               Panel.ZIndex="0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Project.Media.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox x:Name="MediaList"
                             ItemsSource="{Binding MediaView}"
                             SelectedItem="{Binding SelectedAsset}"
                             PreviewMouseLeftButtonDown="MediaList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="MediaList_PreviewMouseMove"
                             MouseDoubleClick="MediaList_MouseDoubleClick"
                             Panel.ZIndex="1">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="137" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="137" Margin="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="78" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="7" Background="{StaticResource PanelRaisedBrush}" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                            <Border Background="#99000000" CornerRadius="4" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5">
                                                <TextBlock Text="{Binding DurationLabel}" FontSize="9" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="2,6,2,0" ToolTip="{Binding Name}" />
                                    <TextBlock Grid.Row="2" Text="{Binding ResolutionLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="2,2,2,4" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <!-- Анализ видео -->
        <Border x:Name="AnalysisPanel"
                Grid.Row="1"
                Grid.Column="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="130" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="2,2,0,13">
                    <TextBlock Text="AI-анализ" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Каскад: общий обзор → точная зона → граница до кадра"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Видео" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,0,5" />
                    <ComboBox x:Name="AnalysisAssetComboBox"
                              ItemsSource="{Binding Project.Media}"
                              SelectedItem="{Binding SelectedAsset}"
                              TextSearch.TextPath="Name">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Запрос" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,0,5" />
                    <TextBox x:Name="AnalysisPromptTextBox"
                             Text="Найди опенинг, эндинг и превью"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Height="78" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="От" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,0,5" />
                        <TextBox x:Name="AnalysisStartTextBox" Text="0:00" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="До" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,0,5" />
                        <TextBox x:Name="AnalysisEndTextBox" Text="0:00" />
                    </StackPanel>
                </Grid>

                <Expander Grid.Row="4"
                          Header="Дополнительно: локальная модель"
                          IsExpanded="False"
                          Foreground="{StaticResource TextBrush}"
                          Margin="0,0,0,9">
                <Border
                        Background="#171820"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="9"
                        Margin="0,7,0,0">
                    <StackPanel>
                        <CheckBox x:Name="UseLocalAiCheckBox"
                                  IsChecked="True"
                                  Content="Уточнить локальным ИИ (Ollama)"
                                  FontWeight="SemiBold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LocalAiModelComboBox"
                                      DisplayMemberPath="DisplayName"
                                      MinWidth="150" />
                            <Button x:Name="RefreshLocalAiModelsButton"
                                    Grid.Column="2"
                                    Style="{StaticResource ButtonBase}"
                                    Click="RefreshLocalAiModels_Click"
                                    Content="Обновить"
                                    Padding="8,5" />
                        </Grid>
                        <TextBlock x:Name="LocalAiStatusTextBlock"
                                   Text="Проверка локальной модели…"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="9"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                </Expander>

                <Button Grid.Row="5"
                        Visibility="Collapsed"
                        Style="{StaticResource ButtonBase}"
                        Click="UseSelectedClipRange_Click"
                        Content="Взять диапазон выбранного клипа"
                        Padding="10,7"
                        Margin="0,0,0,9" />

                <StackPanel Grid.Row="6" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RunAnalysisButton"
                                Grid.Column="0"
                                Style="{StaticResource AccentButton}"
                                Click="RunAnalysis_Click"
                                Content="Анализировать точно"
                                Padding="13,9" />
                        <Button x:Name="CancelAnalysisButton"
                                Grid.Column="2"
                                Style="{StaticResource ButtonBase}"
                                Click="CancelAnalysis_Click"
                                Content="Отмена"
                                Padding="12,9"
                                IsEnabled="False" />
                    </Grid>

                    <Button x:Name="ApplyEditPromptButton"
                            Style="{StaticResource ButtonBase}"
                            Click="ApplyEditPrompt_Click"
                            Content="Применить как команду монтажа"
                            ToolTip="ИИ применит команды во временном черновике. Результат можно принять или полностью вернуть."
                            Padding="10,8"
                            Margin="0,8,0,0" />

                    <Border x:Name="EditReviewPanel"
                            Background="#202133"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="9"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Черновик ИИ применён"
                                       FontWeight="SemiBold"
                                       Foreground="#CBB8FF" />
                            <TextBlock x:Name="EditReviewSummaryTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       Margin="0,4,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource AccentButton}"
                                        Click="AcceptEditReview_Click"
                                        Content="Принять" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource ButtonBase}"
                                        Click="RejectEditReview_Click"
                                        Content="Вернуть как было" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="AnalysisProgressBar" Grid.Row="0" Height="5" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                    <TextBlock x:Name="AnalysisSummaryTextBlock"
                               Grid.Row="1"
                               Text="Выберите видео и задайте запрос."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,8,0,8" />
                    <ListBox x:Name="AnalysisMarkersList"
                             Grid.Row="2"
                             ItemsSource="{Binding Project.Markers}"
                             MouseDoubleClick="AnalysisMarkersList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="7,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding ConfidenceLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding TimeLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="#AEB2C5" FontSize="9" TextWrapping="Wrap" MaxHeight="42" Margin="0,3,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Button Grid.Row="8"
                        Style="{StaticResource ButtonBase}"
                        Click="ClearAnalysisMarkers_Click"
                        Content="Очистить метки анализа"
                        Padding="10,7"
                        Margin="0,10,0,0" />
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- Встроенная история версий -->
        <Border x:Name="HistoryPanel"
                Grid.Row="1" Grid.Column="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Visibility="Collapsed">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="2,2,0,13">
                    <TextBlock Text="История версий" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Контрольные точки проекта" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
                <TextBox x:Name="InlineHistoryMessageTextBox" Grid.Row="1" Text="Новая версия" MaxLength="160" Margin="0,0,0,8" />
                <Button Grid.Row="2" Style="{StaticResource AccentButton}" Click="CreateInlineCheckpoint_Click" Content="Создать контрольную точку" Padding="10,8" Margin="0,0,0,10" />
                <Grid Grid.Row="3">
                    <TextBlock x:Name="InlineHistoryEmptyText"
                               Text="История пока пуста"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ListBox x:Name="InlineHistoryList" MouseDoubleClick="InlineHistoryList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,7">
                                    <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CreatedLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource ButtonBase}" Click="RestoreInlineCheckpoint_Click" Content="Откатиться" Padding="10,7" />
                    <Button Grid.Column="2" Style="{StaticResource CompactIconButton}" Click="ProjectHistory_Click" Content="&#xE8A7;" ToolTip="Открыть полное окно истории" />
                </Grid>
            </Grid>
        </Border>

        <!-- Текст и субтитры -->
        <Border x:Name="TextPanel"
                Grid.Row="1" Grid.Column="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">
                    <TextBlock Text="Текст и субтитры" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Текст отображается в плеере и попадает в экспорт"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource AccentButton}" Click="CreateTextOverlay_Click" Content="Добавить текст" Padding="8,7" />
                        <Button x:Name="AutoSubtitlesButton" Grid.Column="2" Style="{StaticResource ButtonBase}" Click="AutoSubtitles_Click" Content="Автосубтитры" Padding="8,7" />
                    </Grid>
                    <TextBlock x:Name="WhisperStatusText"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="9"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <Button Style="{StaticResource ButtonBase}" Click="ImportSrt_Click" Content="Импортировать SRT…" Padding="8,7" Margin="0,0,0,10" />

                    <ListBox x:Name="TextOverlayList"
                             ItemsSource="{Binding Project.TextOverlays}"
                             Height="105"
                             SelectionChanged="TextOverlayList_SelectionChanged"
                             Margin="0,0,0,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="7,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Содержимое" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBox Text="{Binding SelectedItem.Text, ElementName=TextOverlayList, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="58"
                             GotKeyboardFocus="TextOverlayEdit_Begin" LostKeyboardFocus="TextOverlayEdit_End" Margin="0,4,0,9" />
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Начало, сек." FontSize="9" Foreground="{StaticResource MutedTextBrush}"/><TextBox Text="{Binding SelectedItem.Start, ElementName=TextOverlayList, UpdateSourceTrigger=LostFocus, StringFormat=0.00}" GotKeyboardFocus="TextOverlayEdit_Begin" LostKeyboardFocus="TextOverlayEdit_End"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Длительность, сек." FontSize="9" Foreground="{StaticResource MutedTextBrush}"/><TextBox Text="{Binding SelectedItem.Duration, ElementName=TextOverlayList, UpdateSourceTrigger=LostFocus, StringFormat=0.00}" GotKeyboardFocus="TextOverlayEdit_Begin" LostKeyboardFocus="TextOverlayEdit_End"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                        <ComboBox SelectedValue="{Binding SelectedItem.FontFamily, ElementName=TextOverlayList}" SelectedValuePath="Content">
                            <ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Impact"/><ComboBoxItem Content="Times New Roman"/>
                        </ComboBox>
                        <TextBox Grid.Column="2" Text="{Binding SelectedItem.FontSize, ElementName=TextOverlayList, UpdateSourceTrigger=LostFocus, StringFormat=0}" ToolTip="Размер шрифта" GotKeyboardFocus="TextOverlayEdit_Begin" LostKeyboardFocus="TextOverlayEdit_End" />
                    </Grid>
                    <TextBlock Text="Положение по горизонтали" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding SelectedItem.X, ElementName=TextOverlayList}" PreviewMouseLeftButtonDown="TextOverlayEdit_Begin" PreviewMouseLeftButtonUp="TextOverlayEdit_End" />
                    <TextBlock Text="Положение по вертикали" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding SelectedItem.Y, ElementName=TextOverlayList}" PreviewMouseLeftButtonDown="TextOverlayEdit_Begin" PreviewMouseLeftButtonUp="TextOverlayEdit_End" />
                    <TextBlock Text="Поворот" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                    <Slider Minimum="-180" Maximum="180" Value="{Binding SelectedItem.Rotation, ElementName=TextOverlayList}" PreviewMouseLeftButtonDown="TextOverlayEdit_Begin" PreviewMouseLeftButtonUp="TextOverlayEdit_End" Margin="0,0,0,10" />
                    <ComboBox SelectedValue="{Binding SelectedItem.Color, ElementName=TextOverlayList}" SelectedValuePath="Tag" Margin="0,0,0,10">
                        <ComboBoxItem Content="Белый" Tag="#FFFFFF"/><ComboBoxItem Content="Жёлтый" Tag="#FFE66D"/><ComboBoxItem Content="Голубой" Tag="#7DD3FC"/><ComboBoxItem Content="Розовый" Tag="#F9A8D4"/><ComboBoxItem Content="Зелёный" Tag="#86EFAC"/>
                    </ComboBox>
                    <Button Style="{StaticResource ButtonBase}" Click="DeleteTextOverlay_Click" Content="Удалить выбранный текст" Foreground="#FFBBC2" BorderBrush="#70404A" Padding="8,7" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Переходы -->
        <Border x:Name="TransitionsPanel"
                Grid.Row="1" Grid.Column="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Visibility="Collapsed">
            <StackPanel Margin="14">
                <TextBlock Text="Переходы" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Выберите левый клип у склейки. Переход использует доступные края исходников."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,14" />
                <TextBlock Text="Тип" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                <ComboBox x:Name="TransitionKindComboBox" SelectedIndex="0" Margin="0,4,0,10">
                    <ComboBoxItem Content="Перекрёстное растворение" Tag="CrossDissolve" />
                    <ComboBoxItem Content="Затемнение в чёрный" Tag="DipToBlack" />
                    <ComboBoxItem Content="Затемнение в белый" Tag="DipToWhite" />
                    <ComboBoxItem Content="Вытеснение" Tag="Wipe" />
                    <ComboBoxItem Content="Сдвиг" Tag="Slide" />
                    <ComboBoxItem Content="Плавный аудиопереход" Tag="ConstantPowerAudio" />
                </ComboBox>
                <TextBlock Text="Длительность, сек." Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                <TextBox x:Name="TransitionDurationTextBox" Text="1.0" Margin="0,4,0,12" />
                <Button Style="{StaticResource AccentButton}" Click="AddTransition_Click" Content="Добавить на выбранную склейку" Padding="8,8" />
                <TextBlock x:Name="TransitionStatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,12" />
                <TextBlock Text="Переходы проекта" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="TransitionListBox" Height="180" DisplayMemberPath="Label" Margin="0,0,0,10" />
                <Button Style="{StaticResource ButtonBase}" Click="DeleteTransition_Click" Content="Удалить выбранный переход" Foreground="#FFBBC2" BorderBrush="#70404A" Padding="8,7" />
            </StackPanel>
        </Border>

        <GridSplitter Grid.Row="1"
                      Grid.Column="2"
                      Style="{StaticResource PaneSplitter}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeWE"
                      ToolTip="Изменить ширину медиатеки" />

        <!-- Предпросмотр -->
        <Grid Grid.Row="1" Grid.Column="3" Background="{StaticResource WindowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8">
                <Viewbox x:Name="PreviewViewbox" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform>
                        <ScaleTransform x:Name="PreviewScaleTransform" ScaleX="1" ScaleY="1" />
                    </Viewbox.RenderTransform>
                    <Border Width="960" Height="540" Background="Black" BorderBrush="#383942" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                            <Canvas x:Name="PreviewTextCanvas" Width="960" Height="540">
                                <Canvas x:Name="PreviewPassiveTextLayer"
                                        Width="960"
                                        Height="540"
                                        IsHitTestVisible="False" />
                                <Border x:Name="PreviewTextBorder"
                                        Visibility="Collapsed"
                                        Background="#66000000"
                                        CornerRadius="4"
                                        Padding="8,3"
                                        Cursor="SizeAll"
                                        ToolTip="Перетащите текст мышью"
                                        PreviewMouseLeftButtonDown="PreviewTextBorder_MouseLeftButtonDown"
                                        PreviewMouseMove="PreviewTextBorder_MouseMove"
                                        PreviewMouseLeftButtonUp="PreviewTextBorder_MouseLeftButtonUp">
                                    <Grid>
                                        <Rectangle x:Name="PreviewTextSelectionOutline"
                                                   Visibility="Collapsed"
                                                   Stroke="#60A5FA"
                                                   StrokeThickness="2"
                                                   StrokeDashArray="4,3"
                                                   IsHitTestVisible="False" />
                                        <TextBlock x:Name="PreviewTextBlock"
                                                   Margin="8"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="Black" Opacity="0.9" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBox x:Name="PreviewTextEditor"
                                                 Visibility="Collapsed"
                                                 Margin="8"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="False"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalContentAlignment="Stretch"
                                                 VerticalContentAlignment="Top"
                                                 Background="#CC111217"
                                                 Foreground="White"
                                                 BorderThickness="0"
                                                 TextChanged="PreviewTextEditor_TextChanged"
                                                 PreviewKeyDown="PreviewTextEditor_PreviewKeyDown"
                                                 LostKeyboardFocus="PreviewTextEditor_LostKeyboardFocus" />
                                        <Grid x:Name="PreviewTextResizeHandles"
                                              Visibility="Collapsed"
                                              Panel.ZIndex="20">
                                            <Grid.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="Width" Value="11" />
                                                    <Setter Property="Height" Value="11" />
                                                    <Setter Property="Background" Value="#F8FAFC" />
                                                    <Setter Property="BorderBrush" Value="#3B82F6" />
                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                    <Setter Property="CornerRadius" Value="5.5" />
                                                </Style>
                                            </Grid.Resources>

                                            <Border Tag="TopLeft" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" />
                                            <Border Tag="Top" Width="28" Height="8" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="SizeNS" />
                                            <Border Tag="TopRight" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" />
                                            <Border Tag="Right" Width="8" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="SizeWE" />
                                            <Border Tag="BottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" />
                                            <Border Tag="Bottom" Width="28" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="SizeNS" />
                                            <Border Tag="BottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" />
                                            <Border Tag="Left" Width="8" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Canvas>
                            <Grid x:Name="EmptyPreview">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="#656670" HorizontalAlignment="Center" />
                                    <TextBlock Text="Предпросмотр" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,5" />
                                    <TextBlock Text="Добавьте медиа на таймлайн" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>

            <Grid Grid.Row="1" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" HorizontalAlignment="Right" Text="{Binding PlayheadLabel}" FontFamily="Consolas" FontSize="12" Margin="0,0,13,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Click="PreviousFrame_Click" ToolTip="Предыдущий кадр" Content="&#xE892;" Margin="0,0,7,0" />
                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Click="PlayPause_Click" ToolTip="Воспроизведение (Пробел)" Content="&#xE768;" Width="44" Height="44" FontSize="18" />
                    <Button Style="{StaticResource IconButton}" Click="NextFrame_Click" ToolTip="Следующий кадр" Content="&#xE893;" Margin="7,0,0,0" />
                    <Button Style="{StaticResource CompactIconButton}" Click="PreviewZoomOut_Click" ToolTip="Отдалить предпросмотр" Content="&#xE738;" Margin="14,7,3,7" />
                    <TextBlock x:Name="PreviewZoomLabel" Text="100%" Foreground="{StaticResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" Width="38" TextAlignment="Center" />
                    <Button Style="{StaticResource CompactIconButton}" Click="PreviewZoomIn_Click" ToolTip="Приблизить предпросмотр" Content="&#xE710;" Margin="3,7,12,7" />
                    <ComboBox x:Name="PreviewQualityComboBox"
                              Width="105"
                              Height="30"
                              ToolTip="Качество предпросмотра"
                              SelectionChanged="PreviewQuality_Changed"
                              SelectedIndex="0">
                        <ComboBoxItem Content="1/2 качества" Tag="Half" />
                        <ComboBoxItem Content="Оригинал" Tag="Original" />
                    </ComboBox>
                </StackPanel>
                <TextBlock Grid.Column="2" HorizontalAlignment="Left" Text="{Binding TimelineDurationLabel}" FontFamily="Consolas" FontSize="12" Margin="13,0,0,0" />
            </Grid>

        </Grid>

        <GridSplitter Grid.Row="1"
                      Grid.Column="4"
                      Visibility="Collapsed"
                      Style="{StaticResource PaneSplitter}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeWE"
                      ToolTip="Изменить ширину панели свойств" />

        <!-- Инспектор -->
        <Border Grid.Row="1" Grid.Column="5" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="16">
                <StackPanel>
                    <TextBlock Text="Клип" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,18" />
                    <TextBlock Text="Выберите клип на таймлайне, чтобы изменить его параметры."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedClip}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Visibility="{Binding HasSelectedClip, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SelectedClipName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedClipName}" />
                        <TextBlock Text="{Binding SelectedClipTrackLabel}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="10"
                                   Margin="0,4,0,16" />

                        <Expander Header="Точные время и обрезка"
                                  IsExpanded="False"
                                  Foreground="{StaticResource TextBrush}"
                                  Margin="0,0,0,16">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Позиция клипа, сек." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,5" />
                                <TextBox Text="{Binding SelectedClip.Start, UpdateSourceTrigger=LostFocus, StringFormat=0.00}"
                                         GotKeyboardFocus="InspectorEdit_Begin"
                                         LostKeyboardFocus="InspectorEdit_End"
                                         ToolTip="Где клип начинается на таймлайне"
                                         Margin="0,0,0,10" />

                                <TextBlock Text="Начало внутри исходника, сек." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,5" />
                                <TextBox Text="{Binding SelectedClip.SourceStart, UpdateSourceTrigger=LostFocus, StringFormat=0.00}"
                                         GotKeyboardFocus="InspectorEdit_Begin"
                                         LostKeyboardFocus="InspectorEdit_End"
                                         ToolTip="С какой секунды исходного файла начинается клип"
                                         Margin="0,0,0,10" />

                                <TextBlock Text="Длительность клипа, сек." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,5" />
                                <TextBox Text="{Binding SelectedClip.Duration, UpdateSourceTrigger=LostFocus, StringFormat=0.00}"
                                         GotKeyboardFocus="InspectorEdit_Begin"
                                         LostKeyboardFocus="InspectorEdit_End" />
                            </StackPanel>
                        </Expander>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Громкость" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedClip.Volume, StringFormat={}{0:P0}}" FontSize="11" />
                        </Grid>
                        <Slider Minimum="0" Maximum="2" Value="{Binding SelectedClip.Volume, UpdateSourceTrigger=PropertyChanged}"
                                PreviewMouseLeftButtonDown="InspectorEdit_Begin" PreviewMouseLeftButtonUp="InspectorEdit_End" Margin="0,0,0,11" />
                        <CheckBox Content="Отключить звук" IsChecked="{Binding SelectedClip.IsMuted}" Foreground="{StaticResource TextBrush}"
                                  PreviewMouseLeftButtonDown="InspectorEdit_Begin"
                                  Checked="InspectorToggle_Changed" Unchecked="InspectorToggle_Changed" Margin="0,0,0,20" />

                        <Button Style="{StaticResource ButtonBase}" Click="Split_Click" Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                                <TextBlock Text="Разрезать в позиции курсора" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ButtonBase}" Click="DeleteClip_Click" Foreground="#FFBBC2" BorderBrush="#70404A">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                                <TextBlock Text="Удалить клип" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2"
                      Grid.ColumnSpan="6"
                      Style="{StaticResource PaneSplitter}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS"
                      ToolTip="Изменить высоту предпросмотра и таймлайна" />

        <!-- Таймлайн -->
        <Border Grid.Row="3" Grid.ColumnSpan="6" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Grid.Column="0" Background="{StaticResource PanelBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Button Style="{StaticResource IconButton}" Click="Split_Click" ToolTip="Разрезать (S)" Content="&#xE8C6;" Margin="0,0,6,0" />
                        <Button Style="{StaticResource IconButton}" Click="DeleteClip_Click" ToolTip="Удалить (Delete)" Content="&#xE74D;" />
                        <Button Style="{StaticResource IconButton}" Click="SetInPoint_Click" ToolTip="Поставить точку входа (I)" Content="I" Margin="10,0,5,0" />
                        <Button Style="{StaticResource IconButton}" Click="SetOutPoint_Click" ToolTip="Поставить точку выхода (O)" Content="O" Margin="0,0,5,0" />
                        <Button Style="{StaticResource IconButton}" Click="ClearInOut_Click" ToolTip="Очистить точки In/Out" Content="×" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Таймлайн" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Масштаб" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,10,0" />
                        <Button Style="{StaticResource IconButton}" Click="ZoomOut_Click" ToolTip="Уменьшить" Content="&#xE738;" Margin="0,0,5,0" />
                        <Button Style="{StaticResource IconButton}" Click="ZoomToFit_Click" ToolTip="Показать весь проект" Content="&#xE9A6;" Margin="0,0,5,0" />
                        <Button Style="{StaticResource IconButton}" Click="ZoomIn_Click" ToolTip="Увеличить" Content="&#xE710;" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="TimelineScrollViewer"
                              Grid.Row="1"
                              Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="Both"
                              ScrollChanged="TimelineScrollViewer_ScrollChanged"
                              PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel">
                    <controls:TimelineControl x:Name="TimelineEditor"
                                              ContextMenuOpening="TimelineEditor_ContextMenuOpening">
                        <controls:TimelineControl.ContextMenu>
                            <ContextMenu Background="{StaticResource PanelRaisedBrush}"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         Padding="4">
                                <MenuItem Header="Разрезать в позиции курсора" Click="Split_Click" Padding="12,8" />
                                <Separator Background="{StaticResource BorderBrush}" Margin="4,2" />
                                <MenuItem Header="Удалить выбранный элемент" Click="DeleteClip_Click" Padding="12,8" />
                                <Separator Background="{StaticResource BorderBrush}" Margin="4,2" />
                                <MenuItem Header="Разорвать связь видео и звука" Click="UnlinkClip_Click" Padding="12,8" />
                                <Separator Background="{StaticResource BorderBrush}" Margin="4,2" />
                                <MenuItem Header="Поставить точку входа (I)" Click="SetInPoint_Click" Padding="12,8" />
                                <MenuItem Header="Поставить точку выхода (O)" Click="SetOutPoint_Click" Padding="12,8" />
                                <MenuItem Header="Очистить In/Out" Click="ClearInOut_Click" Padding="12,8" />
                            </ContextMenu>
                        </controls:TimelineControl.ContextMenu>
                    </controls:TimelineControl>
                </ScrollViewer>

                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                        Background="#111217"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,0,0"
                        Padding="7,9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" ToolTip="Уровни левого и правого каналов">
                            <Path Data="M3,12 A9,9 0 0 1 21,12 M3,12 L3,19 L7,19 L7,13 L3,13 M21,12 L21,19 L17,19 L17,13 L21,13"
                                  Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" />
                        </Viewbox>
                        <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="AudioLeftMeter" Orientation="Vertical" Width="15" Height="240" Minimum="0" Maximum="1" Value="0" Foreground="#34D399" />
                            <ProgressBar x:Name="AudioRightMeter" Grid.Column="2" Orientation="Vertical" Width="15" Height="240" Minimum="0" Maximum="1" Value="0" Foreground="#60A5FA" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="L" Foreground="#6EE7B7" HorizontalAlignment="Center" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="R" Foreground="#93C5FD" HorizontalAlignment="Center" FontWeight="Bold" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Строка состояния -->
        <Border Grid.Row="4" Grid.ColumnSpan="6" Background="#111217" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                <TextBlock Text="Локальная обработка • исходники не загружаются в интернет" Foreground="#686A74" FontSize="10" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- Блокировка интерфейса во время длительной операции -->
        <Border Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="6"
                Background="#66000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="100">
            <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="10" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="220" Height="5" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding StatusText}" Margin="0,13,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
