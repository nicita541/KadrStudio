<Window x:Class="KadrStudio.Views.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kadr Studio"
        Width="980"
        Height="660"
        MinWidth="820"
        MinHeight="560"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="К" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Kadr Studio" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Локальный видеоредактор" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="34,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Начать монтаж" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Создайте новый проект или откройте сохранённый файл Kadr Studio."
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Margin="0,0,0,28" />

                <Button Style="{StaticResource AccentButton}" Click="NewProject_Click" HorizontalAlignment="Stretch" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,10,0" />
                        <TextBlock Text="Новый проект" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ButtonBase}" Click="OpenProject_Click" HorizontalAlignment="Stretch" Padding="18,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,10,0" />
                        <TextBlock Text="Открыть проект" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,26,0,0">
                    <StackPanel>
                        <TextBlock Text="Все файлы остаются на этом компьютере." FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="Недавние проекты хранят только локальные пути к файлам."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Недавние проекты" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Двойной клик — открыть" Foreground="{StaticResource MutedTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptyRecentText"
                                   Text="Недавних проектов пока нет.&#x0a;Сохранённые проекты появятся здесь автоматически."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Width="300" />
                        <ListBox x:Name="RecentProjectsList"
                                 ItemsSource="{Binding RecentProjects}"
                                 MouseDoubleClick="RecentProjectsList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,9" MinHeight="45">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="{Binding LocationLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                                        <TextBlock Grid.Row="2" Text="{Binding LastOpenedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="#747681" FontSize="9" Margin="0,4,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource ButtonBase}" Click="RemoveRecent_Click" Content="Убрать из списка" Padding="13,7" Margin="0,0,8,0" />
                        <Button Style="{StaticResource AccentButton}" Click="OpenSelectedRecent_Click" Content="Открыть выбранный" Padding="15,7" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#111217" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="Kadr Studio • локальная обработка медиа" Foreground="#686A74" FontSize="10" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
