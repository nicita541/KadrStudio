<Window x:Class="KadrStudio.Views.UpscaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Upscale — AnimeSR-X" Width="520" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="AnimeSR-X (экспериментальный)" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Margin="0,5,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                       Text="Выберите одну или несколько видеодорожек активной Source/Draft-последовательности. Для каждой будет создана отдельная производная дорожка; звук не меняется."/>
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}" BorderBrush="{StaticResource BorderBrush}"
                 Background="{StaticResource PanelBrush}" Padding="8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="3,5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Margin="0,12,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Масштаб" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
            <ComboBox x:Name="ScaleComboBox" Grid.Column="2" SelectedIndex="0">
                <ComboBoxItem Content="Auto → 2160p (рекомендуется)" Tag="Auto2160p"/>
                <ComboBoxItem Content="x2" Tag="X2"/>
                <ComboBoxItem Content="x4" Tag="X4"/>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="HEVC Main10 CRF 14; резервный H.264 High CRF 14" FontSize="9"
                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="Отмена" Click="Cancel_Click" Padding="12,7"/>
            <Button Grid.Column="3" Style="{StaticResource AccentButton}" Content="Запустить" Click="Start_Click" Padding="12,7"/>
        </Grid>
    </Grid>
</Window>
